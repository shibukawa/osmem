{
  "name": "@osmem/core",
  "version": "0.1.4",
  "description": "In-memory OpenSearch-compatible server for tests (osmem-server launcher and clone helpers)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shibukawa/osmem.git",
    "directory": "packages/node/core"
  },
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "optionalDependencies": {
    "@osmem/darwin-arm64": "0.1.4",
    "@osmem/linux-x64": "0.1.4",
    "@osmem/linux-arm64": "0.1.4",
    "@osmem/win32-x64": "0.1.4",
    "@osmem/win32-arm64": "0.1.4"
  },
  "keywords": [
    "opensearch",
    "elasticsearch",
    "testing",
    "in-memory",
    "fake"
  ],
  "publishConfig": {
    "access": "public"
  }
}
